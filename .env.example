# Copy to .env.local for local development. Production requires durable lead storage.

# Server-only credentials for the Snowlawna marketing_leads table.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Canonical site URL, used for metadata, Open Graph images, robots.txt and the sitemap.
# On Vercel this falls back to the project's production domain automatically.
# NEXT_PUBLIC_SITE_URL=https://www.snowlawna.com

# Public contact address. When set, the contact page lists it and the lead form offers a
# prefilled mailto: link if a submission fails. Leave unset to hide email addresses entirely.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Local development only; never used in production.
# LEADS_FILE=.data/leads.jsonl
